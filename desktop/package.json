{
  "name": "star-code",
  "productName": "Star",
  "version": "1.18.0",
  "description": "Star — a local, provider-agnostic agentic desktop app. Bring your own model — DeepSeek, OpenAI, Anthropic, Ollama, or any OpenAI-compatible endpoint — and let it read, search, edit, and run commands in your project.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "llm",
    "deepseek",
    "openai",
    "anthropic",
    "ollama",
    "electron",
    "developer-tools"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Star-Code-Prod/Star-Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/Star-Code-Prod/Star-Code.git"
  },
  "author": {
    "name": "praisethefacts",
    "email": "cryphor@outlook.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "star-code": "bin/star-code.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "cli": "node bin/star-code.mjs",
    "icons": "node tools/make-icons.mjs",
    "shot": "node tools/uishot.mjs",
    "verify": "node tools/verify-core.mjs && node tools/verify-download.mjs && node tools/verify-agents.mjs && node tools/verify-ui.mjs && node tools/verify-design.mjs && node tools/verify-render.mjs && node tools/verify-server.mjs && node tools/verify-sessions.mjs && node tools/verify-cli.mjs && node tools/verify-tui.mjs && node tools/verify-star-chart.mjs && node tools/verify-import.mjs && node tools/verify-mcp.mjs && node tools/verify-gitignore.mjs && node tools/verify-readme.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder -mwl --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.starcode.app",
    "productName": "Star",
    "copyright": "MIT Licensed",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Star-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Star",
      "artifactName": "Star-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Star-${version}-portable.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Star-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "praisethefacts <cryphor@outlook.com>",
      "synopsis": "Star — agentic desktop app",
      "artifactName": "Star-${version}-${arch}.${ext}"
    }
  }
}
