{
  "name": "star-code",
  "productName": "Star Code",
  "version": "1.0.0",
  "description": "A local, provider-agnostic agentic coding UI. Bring your own model — DeepSeek, OpenAI, Anthropic, Ollama, or any OpenAI-compatible endpoint — and let it read, search, edit, and run commands in your project.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "llm",
    "deepseek",
    "openai",
    "anthropic",
    "ollama",
    "electron",
    "developer-tools"
  ],
  "license": "MIT",
  "author": {
    "name": "praisethefacts",
    "email": "cryphor@outlook.com"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "icons": "node tools/make-icons.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.starcode.app",
    "productName": "Star Code",
    "copyright": "MIT Licensed",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Star Code",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "praisethefacts <cryphor@outlook.com>",
      "synopsis": "Provider-agnostic agentic coding UI",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
